{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constitucion-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "routes": [{ "pattern": "constitucion.app", "custom_domain": true }],
  // El Worker va primero en /ley, /mcp y en las páginas que tienen versión
  // en Markdown (las elige por el Accept); lo demás se sirve directo.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/leyes", "/bitacora/*", "/ley", "/ley/*", "/mcp", "/mcp/*", "/api/*", "/pdf/*"]
  },
  "observability": { "enabled": true },
  // v2 retira el Durable Object del limitador de peticiones del servicio de
  // búsqueda anterior. Las migraciones aplicadas no se pueden quitar de la lista.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "deleted_classes": ["RateLimiter"] }
  ]
}
