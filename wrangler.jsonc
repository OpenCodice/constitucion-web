{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constitucion-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "routes": [{ "pattern": "constitucion.app", "custom_domain": true }],
  // Lo que es un archivo se sirve directo, sin el Worker (incluidos
  // /ley/{documento}.md y .json); lo que no, llega al Worker (un artículo,
  // /api, /mcp). Solo va primero el Worker donde hay que elegir entre HTML y
  // Markdown por el Accept.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/leyes", "/bitacora/*"]
  },
  "observability": { "enabled": true },
  // v2 retira el Durable Object del limitador de peticiones del servicio de
  // búsqueda anterior. Las migraciones aplicadas no se pueden quitar de la lista.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "deleted_classes": ["RateLimiter"] }
  ]
}
